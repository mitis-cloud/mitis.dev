---
import '../styles/global.css';
import { alternati, linguaDi } from '../i18n';

interface Props {
  titolo?: string;
  descrizione?: string;
}

const percorso = Astro.url.pathname.replace(/\/$/, '') || '/';
const l = linguaDi(percorso);

const predefiniti = {
  it: {
    titolo: 'mitis | Infrastruttura cloud noiosa, che costa la metà',
    descrizione:
      'Consulenza Cloud e DevOps per scaleup e PMI. Kubernetes, Terraform e FinOps a prezzo fisso: infrastruttura prevedibile, spesa sotto controllo, codice tuo.',
    ogImageAlt: 'mitis — infrastruttura cloud noiosa, e che costa la metà',
    vaiAlContenuto: 'Vai al contenuto',
    serviceType: 'Consulenza Cloud e DevOps',
    ogLocale: 'it_IT',
    ogImage: '/og.png',
  },
  en: {
    titolo: 'mitis | Boring cloud infrastructure, at half the cost',
    descrizione:
      'Cloud & DevOps consultancy for scaleups and SMBs. Kubernetes, Terraform and FinOps at a fixed price: predictable infrastructure, spend under control, code that stays yours.',
    ogImageAlt: 'mitis — boring cloud infrastructure, at half the cost',
    vaiAlContenuto: 'Skip to content',
    serviceType: 'Cloud & DevOps consultancy',
    ogLocale: 'en_US',
    ogImage: '/og-en.png',
  },
}[l];

const title = Astro.props.titolo ?? predefiniti.titolo;
const description = Astro.props.descrizione ?? predefiniti.descrizione;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const inHome = percorso === '/' || percorso === '/en';
const ogImage = new URL(predefiniti.ogImage, Astro.site).href;
const alt = alternati(percorso);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'mitis',
  url: Astro.site?.href,
  description,
  serviceType: predefiniti.serviceType,
  areaServed: { '@type': 'Country', name: l === 'en' ? 'Italy' : 'Italia' },
  availableLanguage: ['it', 'en'],
  knowsAbout: [
    'Kubernetes',
    'Terraform',
    'FinOps',
    'AWS',
    'Google Cloud',
    'Microsoft Azure',
    'Atmos',
    'GitOps',
    l === 'en' ? 'Internal platforms' : 'Piattaforme interne',
  ],
  sameAs: ['https://github.com/mitis-cloud'],
};
---

<!doctype html>
<html lang={l}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alt && (
        <>
          <link rel="alternate" hreflang="it" href={new URL(alt.it, Astro.site).href} />
          <link rel="alternate" hreflang="en" href={new URL(alt.en, Astro.site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alt.it, Astro.site).href} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0d120f" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mitis" />
    <meta property="og:locale" content={predefiniti.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={predefiniti.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-v7-latin-800.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-sans-v4-latin-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-v24-latin-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {inHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a
      href="#contenuto"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-quadro focus:px-4 focus:py-2 focus:font-mono focus:text-label focus:text-carta"
    >
      {predefiniti.vaiAlContenuto}
    </a>
    <slot />
    <noscript>
      <style>
        [data-rivela],
        [data-rivela-serie] > * {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <script>
      const osservati = document.querySelectorAll('[data-rivela], [data-rivela-serie]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (voci) => {
            for (const v of voci) {
              if (v.isIntersecting) {
                v.target.classList.add('in');
                io.unobserve(v.target);
              }
            }
          },
          { threshold: 0.05, rootMargin: '0px 0px -6% 0px' },
        );
        osservati.forEach((el) => io.observe(el));
      } else {
        osservati.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
