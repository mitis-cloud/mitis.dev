---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
import { alternati, linguaDi, via } from '../i18n';
import { azienda, contatti } from '../dati';

interface Props {
  titolo?: string;
  descrizione?: string;
  briciola?: string;
  ld?: Record<string, unknown>[];
  cta?: boolean;
  nudo?: boolean;
}

const percorso = Astro.url.pathname.replace(/\/$/, '') || '/';
const l = linguaDi(percorso);

const predefiniti = {
  it: {
    titolo: 'mitis | Consulenza cloud: costi, Kubernetes, rilasci',
    descrizione:
      'Studio di ingegneri cloud. Riduciamo la spesa su AWS, Google Cloud e Azure, costruiamo piattaforme Kubernetes, automatizziamo i rilasci. A prezzo fisso.',
    ogImageAlt: 'mitis: consulenza cloud e Kubernetes',
    vaiAlContenuto: 'Vai al contenuto',
    serviceType: 'Consulenza cloud e Kubernetes',
    ogLocale: 'it_IT',
    ogImage: '/og.png',
  },
  en: {
    titolo: 'mitis | Cloud consulting: costs, Kubernetes, releases',
    descrizione:
      'A studio of cloud engineers. We cut spend on AWS, Google Cloud and Azure, build and fix Kubernetes platforms, and make releases routine. At a fixed price.',
    ogImageAlt: 'mitis: cloud and Kubernetes consulting',
    vaiAlContenuto: 'Skip to content',
    serviceType: 'Cloud and Kubernetes consulting',
    ogLocale: 'en_US',
    ogImage: '/og-en.png',
  },
}[l];

const { briciola, ld = [], cta = true, nudo = false } = Astro.props;
const title = Astro.props.titolo ?? predefiniti.titolo;
const description = Astro.props.descrizione ?? predefiniti.descrizione;
const sito = Astro.site!.href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const inHome = percorso === '/' || percorso === '/en';
const ogImage = new URL(predefiniti.ogImage, Astro.site).href;
const alt = alternati(percorso);
const home = new URL(via(l, '/'), Astro.site).href;

const organizzazione = {
  '@type': 'ProfessionalService',
  '@id': `${sito}#organizzazione`,
  name: 'mitis',
  url: sito,
  logo: new URL('/marchio.svg', Astro.site).href,
  image: ogImage,
  email: contatti.email,
  vatID: `IT${azienda.pIva}`,
  description: predefiniti.descrizione,
  serviceType: predefiniti.serviceType,
  areaServed: [
    { '@type': 'Country', name: l === 'en' ? 'Italy' : 'Italia' },
    { '@type': 'Place', name: l === 'en' ? 'European Union' : 'Unione Europea' },
  ],
  availableLanguage: ['it', 'en'],
  knowsAbout: [
    'Kubernetes',
    'Amazon EKS',
    'Google Kubernetes Engine',
    'Azure Kubernetes Service',
    'Karpenter',
    'FinOps',
    'Terraform',
    'Atmos',
    'GitOps',
    'Argo CD',
    'Kargo',
    'Helm',
    'Platform engineering',
  ],
  sameAs: [contatti.github],
};

const grafo: Record<string, unknown>[] = [organizzazione];
if (inHome) {
  grafo.push({
    '@type': 'WebSite',
    '@id': `${sito}#sito`,
    url: sito,
    name: 'mitis',
    inLanguage: l,
    publisher: { '@id': `${sito}#organizzazione` },
  });
} else {
  grafo.push({
    '@type': 'WebPage',
    '@id': `${canonical}#pagina`,
    url: canonical,
    name: title,
    description,
    inLanguage: l,
    isPartOf: { '@id': `${sito}#sito` },
    about: { '@id': `${sito}#organizzazione` },
  });
}
if (briciola) {
  grafo.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'mitis', item: home },
      { '@type': 'ListItem', position: 2, name: briciola, item: canonical },
    ],
  });
}
grafo.push(...ld);
const jsonLd = { '@context': 'https://schema.org', '@graph': grafo };
---

<!doctype html>
<html lang={l}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alt && (
        <>
          <link rel="alternate" hreflang="it" href={new URL(alt.it, Astro.site).href} />
          <link rel="alternate" hreflang="en" href={new URL(alt.en, Astro.site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alt.it, Astro.site).href} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0e1820" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mitis" />
    <meta property="og:locale" content={predefiniti.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={predefiniti.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/newsreader-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#contenuto"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-inchiostro focus:px-4 focus:py-2 focus:text-s focus:text-fondo"
    >
      {predefiniti.vaiAlContenuto}
    </a>
    <Nav />
    {nudo && <div class="h-[4.5rem] bg-notte" />}
    <main id="contenuto">
      <slot />
    </main>
    {cta && <Cta />}
    <Footer />
    <script>
      const osservati = document.querySelectorAll('[data-cresce]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (voci) => {
            for (const v of voci) {
              if (v.isIntersecting) {
                v.target.classList.add('in');
                io.unobserve(v.target);
              }
            }
          },
          { threshold: 0.25 },
        );
        osservati.forEach((el) => io.observe(el));
      } else {
        osservati.forEach((el) => el.classList.add('in'));
      }

    </script>
    <noscript>
      <style>
        [data-cresce] .barra {
          transform: none !important;
        }
      </style>
    </noscript>
  </body>
</html>
