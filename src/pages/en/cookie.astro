---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Base
  titolo="Cookie policy | mitis"
  descrizione="mitis.dev uses no cookies: neither its own nor third-party ones. End of policy."
>
  <Nav />
  <main id="contenuto" class="px-5 py-14 sm:px-8 md:py-20">
    <div class="mx-auto w-full max-w-3xl">
      <p class="eyebrow mb-5">cookies</p>
      <h1 class="font-display text-h2 font-bold">Cookie policy.</h1>
      <div class="mt-6 space-y-5 text-body text-carta/80">
        <p>This site uses no cookies. None: not technical, not profiling, not third-party.</p>
        <p>
          There is no banner because there is nothing to accept. We don't use localStorage, we
          load no external scripts or resources, and we integrate no services that could set
          cookies on their own behalf.
        </p>
        <p class="font-mono text-s text-carta/60">
          // if one day we ever need one, this page will stop being this boring. But we doubt
          it.
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Base>
