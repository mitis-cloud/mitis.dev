---
import Base from '../../layouts/Base.astro';
---

<Base titolo="Cookie policy | mitis" descrizione="mitis.dev uses no cookies: neither its own nor third-party ones. End of policy." briciola="Cookies" cta={false} nudo>
  <article class="contenitore pt-10 pb-16 md:pt-16 md:pb-24">
    <p class="etichetta !text-accento">cookies</p>
    <h1 class="mt-4 text-h1 font-extrabold">Cookie policy.</h1>
    <div class="prosa mt-8">
        <p>This site uses no cookies. None: not technical, not profiling, not third-party.</p>
        <p>
          There is no banner because there is nothing to accept. We don't use localStorage, we
          load no external scripts or resources, and we integrate no services that could set
          cookies on their own behalf.
        </p>
        <p class="text-s text-sottile italic">
          If one day we ever need a cookie, this page will stop being this boring. But we doubt it.
        </p>
      </div>
  </article>
</Base>
