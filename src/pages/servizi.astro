---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Servizi from '../components/Servizi.astro';
import CtaFinale from '../components/CtaFinale.astro';
import Footer from '../components/Footer.astro';
---

<Base
  titolo="Servizi: assessment gratuito, poi prezzo fisso | mitis"
  descrizione="Si parte da un assessment gratuito; poi prezzo fisso scritto prima di iniziare, e supporto in abbonamento disdicibile. Nessun listino da indovinare."
>
  <Nav />
  <main id="contenuto" class="pt-4 md:pt-8">
    <Servizi h1 />
    <section class="px-5 pb-14 sm:px-8 md:pb-20">
      <div class="mx-auto w-full max-w-6xl" data-rivela>
        <p class="text-body text-carta/75">
          Hai un’obiezione in canna? Probabilmente è già nelle{' '}
          <a href="/faq" class="text-lichene underline underline-offset-4 hover:no-underline"
            >FAQ: le obiezioni vere</a
          >, con la risposta che daremmo in chiamata.
        </p>
      </div>
    </section>
  </main>
  <CtaFinale />
  <Footer />
</Base>
