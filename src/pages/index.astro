---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Clienti from '../components/Clienti.astro';
import Problema from '../components/Problema.astro';
import Pilastri from '../components/Pilastri.astro';
import OpenSource from '../components/OpenSource.astro';
import Velocita from '../components/Velocita.astro';
import Nome from '../components/Nome.astro';
import Servizi from '../components/Servizi.astro';
import CtaFinale from '../components/CtaFinale.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />
  <main id="contenuto">
    <Hero />
    <Clienti />
    <Problema />
    <Pilastri />
    <OpenSource compatta />
    <Velocita compatta />
    <Nome />
    <Servizi />
    <CtaFinale />
  </main>
  <Footer />
</Base>
