---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Clienti from '../components/Clienti.astro';
import Problema from '../components/Problema.astro';
import FinOps from '../components/FinOps.astro';
import Kubernetes from '../components/Kubernetes.astro';
import Consegna from '../components/Consegna.astro';
import Velocita from '../components/Velocita.astro';
import Metodo from '../components/Metodo.astro';
import Deliverable from '../components/Deliverable.astro';
import Percorso from '../components/Percorso.astro';
import Offerte from '../components/Offerte.astro';
import PerChi from '../components/PerChi.astro';
import Faq from '../components/Faq.astro';
import CtaFinale from '../components/CtaFinale.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />
  <main id="contenuto">
    <Hero />
    <Clienti />
    <Problema />
    <FinOps />
    <Kubernetes />
    <Consegna />
    <Velocita />
    <Metodo />
    <Deliverable />
    <Percorso />
    <Offerte />
    <PerChi />
    <Faq />
    <CtaFinale />
  </main>
  <Footer />
</Base>
