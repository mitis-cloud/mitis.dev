---
import Section from './Section.astro';
import Icona from './Icona.astro';
import { contatti } from '../dati';
import { moduli, registro, sorgente } from '../open-source-dati';
import { linguaDi, via } from '../i18n';

interface Props {
  compatta?: boolean;
  h1?: boolean;
}
const { compatta = false } = Astro.props;
const Titolo = Astro.props.h1 ? 'h1' : 'h2';
const Sottotitolo = Astro.props.h1 ? 'h2' : 'h3';
const l = linguaDi(Astro.url.pathname);

const testi = {
  it: {
    eyebrow: 'open source',
    titolo: 'Quello che manteniamo.',
    intro:
      'Costruiamo su fondamenta pubbliche, e una parte di quelle fondamenta la manteniamo noi. Tutto Apache 2.0, tutto leggibile prima ancora di parlarci: è il modo più onesto che conosciamo per farti valutare come lavoriamo.',
    strisciaEtichetta: 'open source · apache 2.0',
    striscia:
      'Understudy, l’operator che tiene vivi i workload a replica singola, e cinque moduli Terraform per Kubernetes su Scaleway.',
    strisciaLink: 'quello che manteniamo →',
    operatoreEtichetta: 'l’operator',
    operatoreTesto:
      'Alta disponibilità best-effort per i workload a replica singola: li tiene vivi attraverso drain, upgrade, consolidamenti e interruzioni spot, senza pagare una seconda replica ventiquattr’ore al giorno.',
    operatoreProva:
      'Su un’interruzione spot reale, misurata su EKS, ha perso 1 richiesta su 764: meno di un normale rolling update.',
    operatoreMeta: 'Go · Apache 2.0 · CRD e webhook di ammissione',
    operatoreLink: 'il repository',
    moduliEtichetta: 'i moduli',
    moduliTitolo: 'Terraform per Scaleway',
    moduliTesto:
      'Cinque moduli per la piattaforma Kubernetes su Scaleway — rete, gateway, cluster, node pool, ACL dell’API server — pubblicati sul Terraform Registry e installabili con una riga.',
    moduliNota:
      'Li abbiamo scritti perché ci servivano: sul lato Kubernetes non trovavamo moduli mantenuti su cui scommettere un cluster di produzione. La documentazione include le stranezze dell’API di Scaleway, quelle che altrimenti scopri all’apply.',
    registro: 'registry',
    sorgente: 'sorgente',
    europaTitolo: 'Perché un cloud europeo',
    europaTesto:
      'Il punto non è la bandiera. È che il metodo non cambia: landing zone, GitOps e FinOps funzionano allo stesso modo su AWS, GCP, Azure e Scaleway — cambia il provider Terraform, non il modo di lavorare. Se tenere i dati in Europa è un tuo requisito, è un’opzione che copriamo davvero, con il codice in chiaro. Se non lo è, resta la prova che lo stesso impianto sappiamo portarlo altrove.',
    standardTitolo: 'Come sono fatti',
    standard: [
      'CI su ogni pull request: formattazione, validazione, lint, esempi che inizializzano',
      'documentazione generata dal codice, con la build che fallisce se è disallineata',
      'semver e changelog: nessuna breaking change silenziosa',
      'esempi completi che girano, non frammenti da incollare',
    ],
    standardChiusura:
      'Se ti sembra pignoleria, è lo stesso livello con cui trattiamo il tuo Terraform.',
  },
  en: {
    eyebrow: 'open source',
    titolo: 'What we maintain.',
    intro:
      'We build on public foundations, and part of those foundations we maintain ourselves. All Apache 2.0, all readable before you even talk to us: it is the most honest way we know to let you judge how we work.',
    strisciaEtichetta: 'open source · apache 2.0',
    striscia:
      'Understudy, the operator that keeps single-replica workloads alive, and five Terraform modules for Kubernetes on Scaleway.',
    strisciaLink: 'what we maintain →',
    operatoreEtichetta: 'the operator',
    operatoreTesto:
      'Best-effort high availability for single-replica workloads: it keeps them alive through drains, upgrades, consolidations and spot interruptions, without paying for a second replica around the clock.',
    operatoreProva:
      'In a real spot interruption, measured on EKS, it lost 1 request out of 764: less than an ordinary rolling update.',
    operatoreMeta: 'Go · Apache 2.0 · CRD and admission webhook',
    operatoreLink: 'the repository',
    moduliEtichetta: 'the modules',
    moduliTitolo: 'Terraform for Scaleway',
    moduliTesto:
      'Five modules for the Kubernetes platform on Scaleway — network, gateway, cluster, node pool, API server ACL — published on the Terraform Registry and installable in one line.',
    moduliNota:
      'We wrote them because we needed them: on the Kubernetes side we could not find maintained modules we would bet a production cluster on. The documentation covers Scaleway API quirks, the ones you would otherwise discover at apply time.',
    registro: 'registry',
    sorgente: 'source',
    europaTitolo: 'Why a European cloud',
    europaTesto:
      'The point is not the flag. It is that the method does not change: landing zone, GitOps and FinOps work the same way on AWS, GCP, Azure and Scaleway — the Terraform provider changes, not how we work. If keeping data in Europe is a requirement of yours, it is an option we genuinely cover, with the code in the open. If it is not, what remains is the proof that we can carry the same setup elsewhere.',
    standardTitolo: 'How they are built',
    standard: [
      'CI on every pull request: formatting, validation, lint, examples that initialize',
      'documentation generated from the code, with the build failing when it drifts',
      'semver and changelogs: no silent breaking changes',
      'complete examples that run, not fragments to paste',
    ],
    standardChiusura:
      'If that reads as fussiness, it is the same standard we hold your Terraform to.',
  },
}[l];
---

{
  compatta ? (
    <section class="px-5 sm:px-8" aria-label={testi.titolo}>
      <div
        class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-10 gap-y-4 border-y border-carta/10 py-7"
        data-rivela
      >
        <p class="font-mono text-label text-carta/55">{testi.strisciaEtichetta}</p>
        <p class="max-w-[62ch] min-w-0 flex-1 text-s text-carta/75">{testi.striscia}</p>
        <a
          href={via(l, '/open-source')}
          class="font-mono text-label text-lichene transition-colors hover:text-carta"
        >
          {testi.strisciaLink}
        </a>
      </div>
    </section>
  ) : (
    <Section id="open-source" eyebrow={testi.eyebrow} class="py-14 md:py-20">
      <Titolo class="max-w-[24ch] font-display text-h2 font-bold" data-rivela>
        {testi.titolo}
      </Titolo>
      <p class="mt-5 max-w-[66ch] text-body text-carta/75" data-rivela>
        {testi.intro}
      </p>

      <div
        class="mt-10 rounded-lg border border-lichene/50 bg-felce/12 p-6 shadow-[0_0_40px_rgba(83,194,135,0.08)] md:p-8"
        data-rivela
      >
        <div class="flex items-center gap-2.5">
          <Icona nome="salvagente" class="h-5 w-5 text-lichene" />
          <p class="font-mono text-label text-lichene">{testi.operatoreEtichetta}</p>
        </div>
        <Sottotitolo class="mt-3 font-mono text-l font-bold">understudy</Sottotitolo>
        <p class="mt-3 max-w-[70ch] text-s text-carta/80">{testi.operatoreTesto}</p>
        <p class="mt-4 max-w-[62ch] border-l-4 border-lichene pl-4 text-body font-medium text-carta">
          {testi.operatoreProva}
        </p>
        <p class="mt-4 font-mono text-label text-carta/60">
          {testi.operatoreMeta} ·{' '}
          <a
            href={contatti.understudy}
            class="text-lichene underline underline-offset-4 hover:no-underline"
          >
            {testi.operatoreLink}
          </a>
        </p>
      </div>

      <div class="mt-12" data-rivela>
        <div class="flex items-center gap-2.5">
          <Icona nome="strati" class="h-5 w-5 text-lichene" />
          <p class="font-mono text-label text-carta/60">{testi.moduliEtichetta}</p>
        </div>
        <Sottotitolo class="mt-3 font-display text-l font-bold">{testi.moduliTitolo}</Sottotitolo>
        <p class="mt-3 max-w-[66ch] text-s text-carta/75">{testi.moduliTesto}</p>
      </div>

      <ul class="mt-7" data-rivela-serie>
        {moduli.map((m) => (
          <li class="group grid gap-x-6 gap-y-1 border-t border-carta/12 py-4 transition-colors hover:border-lichene/50 md:grid-cols-[minmax(0,17rem)_1fr_auto] md:items-baseline">
            <p class="min-w-0 font-mono text-s font-bold text-carta transition-colors group-hover:text-lichene [overflow-wrap:anywhere]">
              {m.nome}
            </p>
            <p class="min-w-0 text-s text-carta/70">{m[l]}</p>
            <p class="flex shrink-0 gap-4 font-mono text-label">
              <a
                href={registro(m.nome)}
                class="text-lichene underline underline-offset-4 hover:no-underline"
              >
                {testi.registro}
              </a>
              <a href={sorgente(m.repo)} class="text-carta/60 transition-colors hover:text-carta">
                {testi.sorgente}
              </a>
            </p>
          </li>
        ))}
      </ul>

      <p class="mt-6 max-w-[70ch] text-s text-carta/65" data-rivela>
        {testi.moduliNota}
      </p>

      <div class="mt-12 grid gap-8 md:grid-cols-2" data-rivela-serie>
        <div class="rounded-lg border border-carta/10 bg-quadro p-6 md:p-7">
          <Sottotitolo class="font-display text-l font-bold">{testi.europaTitolo}</Sottotitolo>
          <p class="mt-3 text-s text-carta/75">{testi.europaTesto}</p>
        </div>
        <div class="rounded-lg border border-carta/10 bg-quadro p-6 md:p-7">
          <Sottotitolo class="font-display text-l font-bold">{testi.standardTitolo}</Sottotitolo>
          <ul class="mt-4 space-y-2.5">
            {testi.standard.map((s) => (
              <li class="flex gap-3 text-s text-carta/75">
                <span class="mt-0.5 shrink-0 font-mono font-bold text-lichene" aria-hidden="true">
                  +
                </span>
                {s}
              </li>
            ))}
          </ul>
          <p class="mt-5 font-mono text-label text-carta/55 italic">
            // {testi.standardChiusura}
          </p>
        </div>
      </div>
    </Section>
  )
}
