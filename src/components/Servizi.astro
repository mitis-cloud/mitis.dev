---
import Section from './Section.astro';
import Icona from './Icona.astro';
import { linguaDi } from '../i18n';

const Titolo = Astro.props.h1 ? 'h1' : 'h2';
const Sottotitolo = Astro.props.h1 ? 'h2' : 'h3';
const l = linguaDi(Astro.url.pathname);

const testi = {
  it: {
    eyebrow: 'servizi',
    titolo: 'Come si compra.',
    intro:
      'Nessun listino da indovinare: si parte da una chiamata gratuita, e ogni prezzo arriva scritto, fisso, prima di iniziare.',
    inEvidenza: 'si parte da qui',
    offerte: [
      {
        icona: 'lente',
        nome: 'assessment',
        prezzo: 'gratuito',
        dettagli: 'una chiamata tecnica + prima lettura',
        testo:
          'Spesa, architettura, margini realistici: usciamo con una fotografia onesta di dove sei e di cosa ci sarebbe da fare, con priorità e ordini di grandezza. Nessun impegno.',
        nota: 'si esce con un parere utile, comunque vada.',
        inEvidenza: true,
      },
      {
        icona: 'fulmine',
        nome: 'acceleratore',
        prezzo: 'prezzo fisso',
        dettagli: 'definito dopo l’assessment, per iscritto',
        testo:
          'La piattaforma completa a scope fisso: landing zone, Kubernetes, GitOps, osservabilità, handover con formazione del team. Esito garantito, con clausola di rimborso. In settimane, non mesi.',
        nota: 'tutto nei tuoi repository, dal primo commit.',
        inEvidenza: false,
      },
      {
        icona: 'salvagente',
        nome: 'supporto continuativo',
        prezzo: 'abbonamento mensile',
        dettagli: 'disdicibile quando vuoi · SLA nel contratto',
        testo:
          'Evoluzioni, reperibilità e un secondo paio d’occhi sulle decisioni di piattaforma, dopo l’handover.',
        nota: 'esiste solo dopo l’handover: non è un modo per restare.',
        inEvidenza: false,
      },
    ],
  },
  en: {
    eyebrow: 'services',
    titolo: 'How buying works.',
    intro:
      'No price list to guess at: it starts with a free call, and every price arrives in writing, fixed, before we begin.',
    inEvidenza: 'start here',
    offerte: [
      {
        icona: 'lente',
        nome: 'assessment',
        prezzo: 'free',
        dettagli: 'a technical call + a first read',
        testo:
          'Spend, architecture, realistic margins: you leave with an honest picture of where you are and what there would be to do, with priorities and orders of magnitude. No commitment.',
        nota: 'you walk away with a useful opinion, whatever happens.',
        inEvidenza: true,
      },
      {
        icona: 'fulmine',
        nome: 'accelerator',
        prezzo: 'fixed price',
        dettagli: 'set after the assessment, in writing',
        testo:
          'The complete platform at a fixed scope: landing zone, Kubernetes, GitOps, observability, handover with team training. Outcome guaranteed, with a refund clause. In weeks, not months.',
        nota: 'everything in your repositories, from the first commit.',
        inEvidenza: false,
      },
      {
        icona: 'salvagente',
        nome: 'ongoing support',
        prezzo: 'monthly subscription',
        dettagli: 'cancel any time · SLA in the contract',
        testo:
          'Evolutions, on-call availability and a second pair of eyes on platform decisions, after the handover.',
        nota: 'exists only after the handover: it is not a way to stay.',
        inEvidenza: false,
      },
    ],
  },
}[l];
---

<Section id="servizi" eyebrow={testi.eyebrow} class="py-14 md:py-20">
  <Titolo class="max-w-[24ch] font-display text-h2 font-bold" data-rivela>{testi.titolo}</Titolo>
  <p class="mt-5 max-w-[62ch] text-body text-carta/75" data-rivela>
    {testi.intro}
  </p>
  <div class="mt-10 grid gap-5 lg:grid-cols-3" data-rivela-serie>
    {
      testi.offerte.map((o) => (
        <div
          class:list={[
            'flex flex-col rounded-lg border p-6 transition-all duration-300 hover:-translate-y-1 md:p-7',
            o.inEvidenza
              ? 'border-lichene/60 bg-felce/12 shadow-[0_0_40px_rgba(83,194,135,0.08)] hover:shadow-[0_0_50px_rgba(83,194,135,0.16)]'
              : 'border-carta/12 bg-quadro hover:border-carta/30',
          ]}
        >
          <div class="flex items-center justify-between">
            <Icona nome={o.icona} class="h-6 w-6 text-lichene" />
            {o.inEvidenza && (
              <p class="font-mono text-label font-bold text-lichene">{testi.inEvidenza}</p>
            )}
          </div>
          <Sottotitolo class="mt-4 font-mono text-body font-bold">{o.nome}</Sottotitolo>
          <p class="mt-3 font-mono text-l">{o.prezzo}</p>
          <p class="mt-1 font-mono text-label text-carta/60">{o.dettagli}</p>
          <p class="mt-4 text-s text-carta/75">{o.testo}</p>
          <p class="mt-auto pt-4 font-mono text-label text-carta/55 italic">// {o.nota}</p>
        </div>
      ))
    }
  </div>
</Section>
