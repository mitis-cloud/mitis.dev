---
import Wordmark from './Wordmark.astro';
import { contatti } from '../dati';

const links = [
  { href: '#finops', label: 'FinOps' },
  { href: '#kubernetes', label: 'Kubernetes' },
  { href: '#offerte', label: 'Offerte' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="px-5 sm:px-8">
  <nav
    class="mx-auto flex w-full max-w-6xl items-center justify-between gap-6 py-6"
    aria-label="Principale"
  >
    <a href="/" class="text-[1.35rem] leading-none" aria-label="mitis — home">
      <Wordmark />
    </a>
    <div class="flex items-center gap-7">
      <ul class="hidden items-center gap-7 md:flex">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="font-mono text-label text-inchiostro/70 transition-colors hover:text-inchiostro"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={`mailto:${contatti.email}`}
        class="rounded-md bg-felce px-4 py-2 font-mono text-label text-carta transition-colors hover:bg-felce/90"
      >
        Scrivici
      </a>
    </div>
  </nav>
</header>
