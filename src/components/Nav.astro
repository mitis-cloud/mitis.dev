---
import Wordmark from './Wordmark.astro';
import { contatti } from '../dati';

const links = [
  { href: '/finops', label: 'FinOps' },
  { href: '/kubernetes', label: 'Kubernetes' },
  { href: '/devops', label: 'DevOps' },
  { href: '/metodo', label: 'Metodo' },
  { href: '/servizi', label: 'Servizi' },
  { href: '/faq', label: 'FAQ' },
];

const percorso = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-carta/10 bg-sfondo/85 px-5 backdrop-blur-md sm:px-8">
  <nav
    class="mx-auto flex w-full max-w-6xl items-center justify-between gap-6 py-4"
    aria-label="Principale"
  >
    <a href="/" class="text-[1.35rem] leading-none text-carta" aria-label="mitis — home">
      <Wordmark cursor="bg-lichene" />
    </a>
    <div class="flex items-center gap-7">
      <ul class="hidden items-center gap-7 md:flex">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={percorso === l.href ? 'page' : undefined}
                class:list={[
                  'font-mono text-label transition-colors hover:text-carta',
                  percorso === l.href ? 'text-lichene' : 'text-carta/60',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={`mailto:${contatti.email}`}
        class="rounded-md bg-lichene px-4 py-2 font-mono text-label font-medium text-sfondo transition-all hover:bg-lichene/90 hover:shadow-[0_0_20px_rgba(83,194,135,0.35)]"
      >
        Scrivici
      </a>
    </div>
  </nav>
</header>
