---
import Wordmark from './Wordmark.astro';
import { alternati, linguaDi, via } from '../i18n';

const percorso = Astro.url.pathname.replace(/\/$/, '') || '/';
const l = linguaDi(percorso);
const alt = alternati(percorso) ?? { it: '/', en: '/en/' };

const testi = {
  it: {
    links: [
      { href: '/servizi', label: 'Servizi', sotto: ['/finops', '/kubernetes', '/devops'] },
      { href: '/risultati', label: 'Risultati', sotto: ['/open-source'] },
      { href: '/metodo', label: 'Come lavoriamo', sotto: ['/faq'] },
      { href: '/chi-siamo', label: 'Chi siamo', sotto: [] },
    ],
    cta: 'Prenota una chiamata',
    ctaBreve: 'Contatti',
    home: 'mitis, pagina iniziale',
    principale: 'Principale',
    menu: 'Menu',
    lingua: 'Lingua',
  },
  en: {
    links: [
      { href: '/servizi', label: 'Services', sotto: ['/finops', '/kubernetes', '/devops'] },
      { href: '/risultati', label: 'Results', sotto: ['/open-source'] },
      { href: '/metodo', label: 'How we work', sotto: ['/faq'] },
      { href: '/chi-siamo', label: 'About', sotto: [] },
    ],
    cta: 'Book a call',
    ctaBreve: 'Contact',
    home: 'mitis, home page',
    principale: 'Main',
    menu: 'Menu',
    lingua: 'Language',
  },
}[l];

const attivo = (li: { href: string; sotto: string[] }) =>
  [li.href, ...li.sotto].some((h) => percorso === via(l, h));
---

<header class="buio absolute inset-x-0 top-0 z-40 !bg-transparent">
  <nav class="contenitore flex h-[4.5rem] items-center justify-between gap-6" aria-label={testi.principale}>
    <a href={via(l, '/')} class="text-[1.625rem] leading-none" aria-label={testi.home}>
      <Wordmark />
    </a>

    <ul class="hidden items-center gap-9 lg:flex">
      {
        testi.links.map((li) => (
          <li>
            <a
              href={via(l, li.href)}
              aria-current={percorso === via(l, li.href) ? 'page' : undefined}
              class:list={[
                'text-[0.9688rem] font-medium transition-colors hover:text-inchiostro',
                attivo(li) ? 'text-inchiostro' : 'text-tenue',
              ]}
            >
              {li.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-4 sm:gap-6">
      <div class="hidden whitespace-nowrap text-nota font-semibold sm:block" aria-label={testi.lingua}>
        <a
          href={alt.it}
          aria-current={l === 'it' ? 'true' : undefined}
          class:list={['hover:text-inchiostro', l === 'it' ? 'text-inchiostro' : 'text-sottile']}
          lang="it"
          hreflang="it">IT</a
        ><span class="mx-1.5 text-sottile/60" aria-hidden="true">/</span><a
          href={alt.en}
          aria-current={l === 'en' ? 'true' : undefined}
          class:list={['hover:text-inchiostro', l === 'en' ? 'text-inchiostro' : 'text-sottile']}
          lang="en"
          hreflang="en">EN</a
        >
      </div>
      <a href={via(l, '/contatti')} class="btn btn-primario !px-5 !py-3 !text-[0.9375rem]">
        <span class="hidden sm:inline">{testi.cta}</span>
        <span class="sm:hidden">{testi.ctaBreve}</span>
      </a>
      <details class="lg:hidden">
        <summary class="flex h-11 w-11 items-center justify-center rounded-lg border border-filo" aria-label={testi.menu}>
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="8" x2="20" y2="8"></line>
            <line x1="4" y1="16" x2="20" y2="16"></line>
          </svg>
        </summary>
        <div class="absolute inset-x-0 top-[4.5rem] border-y border-filo bg-notte">
          <ul class="contenitore py-2">
            {
              testi.links.map((li) => (
                <li class="border-b border-filo last:border-0">
                  <a href={via(l, li.href)} class="titolo block py-4 text-[1.5rem]">{li.label}</a>
                </li>
              ))
            }
          </ul>
          <div class="contenitore border-t border-filo py-4 text-s font-semibold" aria-label={testi.lingua}>
            <a href={alt.it} class:list={[l === 'it' ? 'text-inchiostro' : 'text-sottile']} lang="it" hreflang="it">Italiano</a>
            <span class="mx-2 text-sottile/60" aria-hidden="true">/</span>
            <a href={alt.en} class:list={[l === 'en' ? 'text-inchiostro' : 'text-sottile']} lang="en" hreflang="en">English</a>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>
