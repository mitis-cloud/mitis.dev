---
import Section from './Section.astro';
import { gruppiPerLingua } from '../faq-dati';
import { linguaDi } from '../i18n';

const l = linguaDi(Astro.url.pathname);
const gruppi = gruppiPerLingua[l];

const testi = {
  it: {
    eyebrow: 'faq',
    titolo: 'Le obiezioni vere.',
    intro:
      'Le domande che ci fanno davvero, con le risposte che daremmo in chiamata. Se la tua non c’è, la chiamata è gratuita.',
  },
  en: {
    eyebrow: 'faq',
    titolo: 'The real objections.',
    intro:
      'The questions we actually get, with the answers we’d give on a call. If yours isn’t here, the call is free.',
  },
}[l];
---

<Section id="faq" eyebrow={testi.eyebrow} class="py-14 md:py-20">
  <h1 class="max-w-[24ch] font-display text-h2 font-bold" data-rivela>{testi.titolo}</h1>
  <p class="mt-5 max-w-[62ch] text-body text-carta/75" data-rivela>
    {testi.intro}
  </p>

  {
    gruppi.map((g) => (
      <div class="mt-12">
        <h2 class="font-mono text-label text-carta/60" data-rivela>
          {g.etichetta}
        </h2>
        <div class="mt-3 max-w-3xl" data-rivela-serie>
          {g.voci.map((f) => (
            <details class="group border-b border-carta/10">
              <summary class="flex cursor-pointer list-none items-baseline justify-between gap-6 py-5 font-display text-l font-bold transition-colors hover:text-lichene [&::-webkit-details-marker]:hidden">
                {f.q}
                <span
                  class="shrink-0 font-mono text-l font-normal text-lichene transition-transform duration-300 group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="max-w-[66ch] pb-6 text-s text-carta/70">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    ))
  }
</Section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    details::details-content {
      opacity: 0;
      block-size: 0;
      overflow: clip;
      transition:
        content-visibility 0.4s allow-discrete,
        opacity 0.4s,
        block-size 0.4s;
    }
    details[open]::details-content {
      opacity: 1;
      block-size: auto;
    }
  }
</style>
