---
import Section from './Section.astro';
import { linguaDi } from '../i18n';

const l = linguaDi(Astro.url.pathname);

const testi = {
  it: {
    eyebrow: 'percorso',
    titolo: 'Tre passi, con i ruoli scritti.',
    tu: 'tu',
    noi: 'noi',
    passi: [
      {
        n: '1',
        titolo: 'Comprendere',
        tu: 'ci dai accesso in sola lettura a billing e account, e mezza giornata del tuo team.',
        noi: 'torniamo con un report prioritizzato: cosa recuperare, cosa sistemare, in che ordine.',
      },
      {
        n: '2',
        titolo: 'Costruire',
        tu: 'un referente tecnico, e le decisioni che spettano a te.',
        noi: 'implementiamo la piattaforma nei tuoi account, via pull request nei tuoi repository, con ambito e prezzo fissati prima.',
      },
      {
        n: '3',
        titolo: 'Consegnare',
        tu: 'il tuo team prende in mano la piattaforma, con noi accanto.',
        noi: 'formazione, runbook, affiancamento. Poi usciamo di scena; se serve, restiamo raggiungibili in abbonamento.',
      },
    ],
  },
  en: {
    eyebrow: 'the path',
    titolo: 'Three steps, with the roles in writing.',
    tu: 'you',
    noi: 'us',
    passi: [
      {
        n: '1',
        titolo: 'Understand',
        tu: 'you give us read-only access to billing and accounts, and half a day of your team’s time.',
        noi: 'we come back with a prioritized report: what to recover, what to fix, in what order.',
      },
      {
        n: '2',
        titolo: 'Build',
        tu: 'one technical point of contact, and the decisions that are yours to make.',
        noi: 'we implement the platform in your accounts, via pull requests in your repositories, with scope and price fixed beforehand.',
      },
      {
        n: '3',
        titolo: 'Hand over',
        tu: 'your team takes charge of the platform, with us alongside.',
        noi: 'training, runbooks, shadowing. Then we step off stage; if needed, we stay reachable on a subscription.',
      },
    ],
  },
}[l];
---

<Section eyebrow={testi.eyebrow} class="py-14 md:py-20">
  <h2 class="max-w-[24ch] font-display text-h2 font-bold" data-rivela>
    {testi.titolo}
  </h2>
  <ol class="mt-10 grid gap-5 lg:grid-cols-3" data-rivela-serie>
    {
      testi.passi.map((p) => (
        <li class="rounded-lg border border-carta/10 bg-quadro p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-carta/25 md:p-7">
          <p class="font-mono text-label text-carta/55">{p.n}.</p>
          <h3 class="mt-1 font-display text-l font-bold">{p.titolo}</h3>
          <dl class="mt-4 space-y-3 text-s">
            <div class="flex gap-3">
              <dt class="w-8 shrink-0 font-mono text-label text-carta/60">{testi.tu}</dt>
              <dd class="text-carta/75">{p.tu}</dd>
            </div>
            <div class="flex gap-3">
              <dt class="w-8 shrink-0 font-mono text-label font-bold text-lichene">{testi.noi}</dt>
              <dd class="text-carta/75">{p.noi}</dd>
            </div>
          </dl>
        </li>
      ))
    }
  </ol>
</Section>
