---
import Section from './Section.astro';

const passi = [
  {
    n: '1',
    titolo: 'Capire',
    tu: 'ci dai accesso in sola lettura a billing e account, e mezza giornata del tuo team.',
    noi: 'torniamo con un report prioritizzato: cosa recuperare, cosa sistemare, in che ordine.',
  },
  {
    n: '2',
    titolo: 'Costruire',
    tu: 'un referente tecnico, e le decisioni che spettano a te.',
    noi: 'implementiamo la piattaforma nei tuoi account, via pull request nei tuoi repository, con ambito e prezzo fissati prima.',
  },
  {
    n: '3',
    titolo: 'Consegnare',
    tu: 'il tuo team prende in mano la piattaforma, con noi accanto.',
    noi: 'formazione, runbook, affiancamento. Poi usciamo di scena; se serve, restiamo raggiungibili in abbonamento.',
  },
];
---

<Section eyebrow="percorso" class="py-14 md:py-20">
  <h2 class="max-w-[24ch] font-display text-h2 font-bold">Tre passi, con i ruoli scritti.</h2>
  <ol class="mt-10 grid gap-5 lg:grid-cols-3">
    {
      passi.map((p) => (
        <li class="rounded-lg border border-inchiostro/12 p-6 md:p-7">
          <p class="font-mono text-label text-inchiostro/65">{p.n}.</p>
          <h3 class="mt-1 font-display text-l font-bold">{p.titolo}</h3>
          <dl class="mt-4 space-y-3 text-s">
            <div class="flex gap-3">
              <dt class="w-8 shrink-0 font-mono text-label text-inchiostro/65">tu</dt>
              <dd class="text-inchiostro/80">{p.tu}</dd>
            </div>
            <div class="flex gap-3">
              <dt class="w-8 shrink-0 font-mono text-label font-bold text-felce">noi</dt>
              <dd class="text-inchiostro/80">{p.noi}</dd>
            </div>
          </dl>
        </li>
      ))
    }
  </ol>
</Section>
