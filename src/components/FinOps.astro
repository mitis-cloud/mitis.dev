---
import Section from './Section.astro';
import { casoFinOps } from '../dati';
import { linguaDi, via } from '../i18n';

const Titolo = Astro.props.h1 ? 'h1' : 'h2';
const Sottotitolo = Astro.props.h1 ? 'h2' : 'h3';
const l = linguaDi(Astro.url.pathname);
const caso = casoFinOps[l];

const testi = {
  it: {
    eyebrow: 'finops',
    titolo: 'Meno spesa, stesse prestazioni.',
    intro:
      'La bolletta cloud non scende chiedendo uno sconto: scende con l’ingegneria. Right-sizing, spot, consolidamento, storage, traffico. Lavoro poco appariscente, molto misurabile.',
    casoEyebrow: 'caso reale, anonimizzato',
    finoAl: 'fino al',
    ariaConta: 'fino al meno settanta per cento',
    casoCorpo:
      'di spesa cloud su una piattaforma multi-tenant enterprise, a parità di carico servito.',
    prima: 'prima',
    dopo: 'dopo',
    settore: 'settore',
    spesa: 'spesa iniziale',
    periodo: 'periodo',
    leveTitolo: 'Cosa è cambiato, in concreto',
    leve: [
      'right-sizing sistematico di compute e database',
      'nodi spot e preemptible dove il carico lo consente',
      'consolidamento dei nodi con Karpenter',
      'classi di storage e lifecycle policy',
      'egress e traffico inter-AZ sotto controllo',
      'risorse orfane e ambienti dimenticati, spenti',
      'copertura a impegno: Savings Plans e CUD',
      'allocazione dei costi per tenant, con showback',
    ],
    promessa:
      'Non promettiamo il 70% a tutti. Promettiamo di dirti in due settimane quanto puoi realisticamente recuperare, e cosa costa ottenerlo.',
    passoPrima: 'Il primo passo è l’',
    passoLink: 'assessment gratuito',
    passoDopo: ': una chiamata tecnica e una prima lettura di spesa e architettura, senza impegno.',
  },
  en: {
    eyebrow: 'finops',
    titolo: 'Less spend, same performance.',
    intro:
      'The cloud bill doesn’t come down by asking for a discount: it comes down through engineering. Right-sizing, spot, consolidation, storage, traffic. Unglamorous work, highly measurable.',
    casoEyebrow: 'real case, anonymized',
    finoAl: 'up to',
    ariaConta: 'up to minus seventy percent',
    casoCorpo:
      'off the cloud bill of an enterprise multi-tenant platform, serving the same load.',
    prima: 'before',
    dopo: 'after',
    settore: 'sector',
    spesa: 'initial spend',
    periodo: 'timeframe',
    leveTitolo: 'What changed, concretely',
    leve: [
      'systematic right-sizing of compute and databases',
      'spot and preemptible nodes wherever the load allows',
      'node consolidation with Karpenter',
      'storage classes and lifecycle policies',
      'egress and cross-AZ traffic under control',
      'orphaned resources and forgotten environments, switched off',
      'commitment coverage: Savings Plans and CUDs',
      'cost allocation per tenant, with showback',
    ],
    promessa:
      'We don’t promise 70% to everyone. We promise to tell you within two weeks how much you can realistically recover, and what it costs to get it.',
    passoPrima: 'The first step is the ',
    passoLink: 'free assessment',
    passoDopo: ': a technical call and a first read of your spend and architecture, no commitment.',
  },
}[l];
---

<Section id="finops" eyebrow={testi.eyebrow} class="py-14 md:py-20">
  <Titolo class="max-w-[24ch] font-display text-h2 font-bold" data-rivela>
    {testi.titolo}
  </Titolo>
  <p class="mt-5 max-w-[62ch] text-body text-carta/75" data-rivela>
    {testi.intro}
  </p>

  <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_1fr]" data-rivela-serie>
    <div class="rapporto rounded-lg border border-carta/12 bg-quadro p-6 md:p-8">
      <p class="font-mono text-label text-carta/60">{testi.casoEyebrow}</p>
      <p
        class="mt-4 font-display text-[clamp(3rem,2.2rem+3vw,4.5rem)] leading-none font-extrabold text-lichene"
        data-conta
        aria-label={testi.ariaConta}
      >
        {testi.finoAl} <span data-conta-numero>−70%</span>
      </p>
      <p class="mt-3 max-w-[44ch] text-body text-carta/85">
        {testi.casoCorpo}
      </p>
      <div class="mt-6 space-y-2" aria-hidden="true">
        <div class="flex items-center gap-3 font-mono text-label text-carta/60">
          <span class="w-12 shrink-0">{testi.prima}</span>
          <div class="h-3 flex-1 overflow-hidden rounded-xs bg-carta/10">
            <div class="barra h-full w-full origin-left rounded-xs bg-carta/45"></div>
          </div>
        </div>
        <div class="flex items-center gap-3 font-mono text-label text-carta/60">
          <span class="w-12 shrink-0">{testi.dopo}</span>
          <div class="h-3 flex-1 overflow-hidden rounded-xs bg-carta/10">
            <div class="barra barra-dopo h-full w-[30%] origin-left rounded-xs bg-lichene"></div>
          </div>
        </div>
      </div>
      <dl class="mt-6 grid gap-x-6 gap-y-2 font-mono text-s sm:grid-cols-[auto_1fr]">
        <dt class="text-carta/60">{testi.settore}</dt>
        <dd class="[overflow-wrap:anywhere] max-sm:mb-2">{caso.settore}</dd>
        <dt class="text-carta/60">{testi.spesa}</dt>
        <dd class="[overflow-wrap:anywhere] max-sm:mb-2">{caso.spesa}</dd>
        <dt class="text-carta/60">{testi.periodo}</dt>
        <dd class="[overflow-wrap:anywhere]">{caso.periodo}</dd>
      </dl>
    </div>

    <div class="flex flex-col justify-between gap-6">
      <div>
        <Sottotitolo class="font-display text-l font-bold">{testi.leveTitolo}</Sottotitolo>
        <ul class="mt-4 grid gap-x-8 gap-y-2 sm:grid-cols-1">
          {
            testi.leve.map((v) => (
              <li class="flex gap-3 text-s text-carta/80">
                <span class="mt-0.5 shrink-0 font-mono font-bold text-lichene" aria-hidden="true">
                  +
                </span>
                {v}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-8 rounded-lg border-l-4 border-lichene bg-felce/12 px-6 py-5 md:px-8" data-rivela>
    <p class="max-w-[70ch] text-l text-carta">
      {testi.promessa}
    </p>
    <p class="mt-2 text-s text-carta/70">
      {testi.passoPrima}<a
        href={via(l, '/servizi')}
        class="text-lichene underline underline-offset-4 hover:no-underline">{testi.passoLink}</a
      >{testi.passoDopo}
    </p>
  </div>
</Section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .barra {
      transform: scaleX(0);
      transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.45s;
    }
    .barra-dopo {
      transition-delay: 0.75s;
    }
    :global([data-rivela-serie].in) .barra {
      transform: scaleX(1);
    }
  }
</style>

<script>
  const blocco = document.querySelector('[data-conta]');
  const numero = document.querySelector<HTMLElement>('[data-conta-numero]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (blocco && numero && !reduced && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (voci) => {
        if (!voci.some((v) => v.isIntersecting)) return;
        io.disconnect();
        const durata = 1400;
        const inizio = performance.now();
        const passo = (t: number) => {
          const x = Math.min((t - inizio) / durata, 1);
          const ease = 1 - Math.pow(1 - x, 3);
          numero.textContent = `−${Math.round(70 * ease)}%`;
          if (x < 1) requestAnimationFrame(passo);
        };
        requestAnimationFrame(passo);
      },
      { threshold: 0.5 },
    );
    io.observe(blocco);
  }
</script>
