---
import Section from './Section.astro';
import Icona from './Icona.astro';
import { linguaDi } from '../i18n';

const Titolo = Astro.props.h1 ? 'h1' : 'h2';
const Sottotitolo = Astro.props.h1 ? 'h2' : 'h3';
const l = linguaDi(Astro.url.pathname);

const testi = {
  it: {
    eyebrow: 'metodo',
    titolo: 'L’open source è gratis. Il sistema è il prodotto.',
    intro:
      'Costruiamo su un ecosistema open source collaudato — moduli Terraform pubblici, componenti riusabili, il framework Atmos, tutto Apache 2.0, usato in produzione da centinaia di team. Stare su fondamenta pubbliche e collaudate è il contrario dell’impianto su misura che solo chi l’ha scritto sa mantenere. Quello che paghi è l’architettura che tiene insieme i pezzi, implementata nei tuoi account.',
    principi: [
      {
        icona: 'scatola',
        titolo: 'Tutto è tuo, dal primo giorno',
        testo:
          'Repository tuoi, account tuoi, pipeline tue. Nessuna piattaforma proprietaria, nessun agente installato, nessuna licenza da rinnovare.',
        nota: 'se un giorno ci mandi via, non perdi niente.',
      },
      {
        icona: 'lucchetto',
        titolo: 'Prezzo fisso, esito garantito',
        testo:
          'Ambito e tempi definiti prima di iniziare, con clausola di rimborso scritta nel contratto. Non vendiamo giornate: vendiamo un risultato.',
        nota: 'chi vende giornate ha interesse ad allungare. chi vende un esito, a finire.',
      },
      {
        icona: 'server',
        titolo: 'Infrastruttura che gira, non slide',
        testo:
          'Il deliverable è una piattaforma in produzione con la sua documentazione, non una roadmap in PDF.',
        nota: 'i pdf non reggono traffico.',
      },
      {
        icona: 'uscita',
        titolo: 'Ce ne andiamo, davvero',
        testo:
          'L’ingaggio finisce con il tuo team che opera la piattaforma: handover e formazione sono nel prezzo. Dopo, se serve, un abbonamento di supporto trasparente.',
        nota: 'la misura del successo è non esserti più necessari.',
      },
    ],
  },
  en: {
    eyebrow: 'method',
    titolo: 'The open source is free. The system is the product.',
    intro:
      'We build on a proven open source ecosystem — public Terraform modules, reusable components, the Atmos framework, all Apache 2.0, used in production by hundreds of teams. Standing on public, proven foundations is the opposite of the bespoke contraption only its author knows how to maintain. What you pay for is the architecture that holds the pieces together, implemented in your accounts.',
    principi: [
      {
        icona: 'scatola',
        titolo: 'Everything is yours, from day one',
        testo:
          'Your repositories, your accounts, your pipelines. No proprietary platform, no installed agents, no license to renew.',
        nota: 'if one day you send us away, you lose nothing.',
      },
      {
        icona: 'lucchetto',
        titolo: 'Fixed price, guaranteed outcome',
        testo:
          'Scope and timeline defined before we start, with a refund clause written into the contract. We don’t sell days: we sell a result.',
        nota: 'whoever sells days has an interest in stretching. whoever sells an outcome, in finishing.',
      },
      {
        icona: 'server',
        titolo: 'Infrastructure that runs, not slides',
        testo:
          'The deliverable is a platform in production with its documentation, not a roadmap in a PDF.',
        nota: 'pdfs don’t serve traffic.',
      },
      {
        icona: 'uscita',
        titolo: 'We actually leave',
        testo:
          'The engagement ends with your team operating the platform: handover and training are in the price. Afterwards, if needed, a transparent support subscription.',
        nota: 'the measure of success is no longer being necessary to you.',
      },
    ],
  },
}[l];
---

<Section eyebrow={testi.eyebrow} class="py-14 md:py-20">
  <Titolo class="max-w-[26ch] font-display text-h2 font-bold" data-rivela>
    {testi.titolo}
  </Titolo>
  <p class="mt-5 max-w-[66ch] text-body text-carta/75" data-rivela>
    {testi.intro}
  </p>

  <div class="mt-10 grid gap-5 md:grid-cols-2" data-rivela-serie>
    {
      testi.principi.map((p) => (
        <div class="flex flex-col rounded-lg border border-carta/10 bg-quadro p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-carta/25 md:p-7">
          <Icona nome={p.icona} class="mb-3 h-6 w-6 text-lichene" />
          <Sottotitolo class="font-display text-l font-bold">{p.titolo}</Sottotitolo>
          <p class="mt-3 text-s text-carta/70">{p.testo}</p>
          <p class="mt-auto pt-4 font-mono text-label text-carta/55 italic">// {p.nota}</p>
        </div>
      ))
    }
  </div>
</Section>
