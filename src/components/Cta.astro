---
import { contatti } from '../dati';
import { linguaDi, via } from '../i18n';

const l = linguaDi(Astro.url.pathname);

const testi = {
  it: {
    titolo: 'Raccontaci la tua situazione.',
    corpo:
      'Mezz’ora in videochiamata con un ingegnere. Se non siamo le persone giuste per il tuo problema, te lo diciamo durante la chiamata.',
    prenota: 'Prenota una chiamata',
    oppure: 'oppure scrivi a',
  },
  en: {
    titolo: 'Tell us about your situation.',
    corpo:
      'Half an hour on a video call with an engineer. If we are not the right people for your problem, we will tell you during the call.',
    prenota: 'Book a call',
    oppure: 'or write to',
  },
}[l];
---

<section class="buio relative isolate overflow-hidden">
  <img
    src="/img/ponte.webp"
    srcset="/img/ponte-1200.webp 1200w, /img/ponte.webp 2400w"
    sizes="100vw"
    alt=""
    width="2400"
    height="1602"
    loading="lazy"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-[70%_45%]"
  />
  <div class="absolute inset-0 -z-10 bg-linear-to-r from-notte from-15% via-notte/60 via-45% to-transparent max-md:via-notte/80 max-md:to-notte/55"></div>
  <div class="contenitore py-24 md:py-36">
    <h2 class="max-w-[14ch] text-h1">{testi.titolo}</h2>
    <p class="mt-6 max-w-[46ch] text-l text-inchiostro/90">{testi.corpo}</p>
    <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href={via(l, '/contatti')} class="btn btn-primario">{testi.prenota}</a>
      <p class="text-s text-inchiostro/85">
        {testi.oppure}{' '}
        <a href={`mailto:${contatti.email}`} class="font-semibold underline underline-offset-4">{contatti.email}</a>
      </p>
    </div>
  </div>
</section>
