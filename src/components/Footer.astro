---
import Wordmark from './Wordmark.astro';
import { azienda, contatti } from '../dati';
import { linguaDi, via } from '../i18n';

const l = linguaDi(Astro.url.pathname);

const testi = {
  it: {
    claim: 'Studio di consulenza cloud. Riduciamo i costi, costruiamo piattaforme Kubernetes, automatizziamo i rilasci.',
    colonne: [
      {
        titolo: 'Servizi',
        voci: [
          { href: '/finops', label: 'Riduzione della spesa cloud' },
          { href: '/kubernetes', label: 'Piattaforma Kubernetes' },
          { href: '/devops', label: 'Rilasci e automazione' },
          { href: '/servizi', label: 'Tutti i servizi' },
        ],
      },
      {
        titolo: 'Studio',
        voci: [
          { href: '/risultati', label: 'Risultati' },
          { href: '/metodo', label: 'Come lavoriamo' },
          { href: '/chi-siamo', label: 'Chi siamo' },
          { href: '/open-source', label: 'Open source' },
          { href: '/faq', label: 'Domande frequenti' },
        ],
      },
    ],
    contatti: 'Contatti',
    chiamata: 'Prenota una chiamata',
    privacy: 'Privacy',
    cookie: 'Informativa cookie',
    niente: 'Questo sito non usa cookie né strumenti di tracciamento.',
  },
  en: {
    claim: 'Cloud consulting studio. We cut costs, build Kubernetes platforms, and automate releases.',
    colonne: [
      {
        titolo: 'Services',
        voci: [
          { href: '/finops', label: 'Cloud cost reduction' },
          { href: '/kubernetes', label: 'Kubernetes platform' },
          { href: '/devops', label: 'Releases and automation' },
          { href: '/servizi', label: 'All services' },
        ],
      },
      {
        titolo: 'Studio',
        voci: [
          { href: '/risultati', label: 'Results' },
          { href: '/metodo', label: 'How we work' },
          { href: '/chi-siamo', label: 'About' },
          { href: '/open-source', label: 'Open source' },
          { href: '/faq', label: 'FAQ' },
        ],
      },
    ],
    contatti: 'Contact',
    chiamata: 'Book a call',
    privacy: 'Privacy',
    cookie: 'Cookie notice',
    niente: 'This site uses no cookies and no tracking tools.',
  },
}[l];
---

<footer class="buio pt-16 pb-10">
  <div class="contenitore">
    <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-12">
      <div class="sm:col-span-2 lg:col-span-5">
        <p class="text-[2rem] leading-none"><Wordmark /></p>
        <p class="mt-5 max-w-[38ch] text-s text-tenue">{testi.claim}</p>
      </div>
      {
        testi.colonne.map((c) => (
          <nav class="lg:col-span-2" aria-label={c.titolo}>
            <p class="etichetta">{c.titolo}</p>
            <ul class="mt-4 space-y-2.5 text-s">
              {c.voci.map((v) => (
                <li>
                  <a href={via(l, v.href)} class="text-tenue transition-colors hover:text-inchiostro">{v.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      <div class="lg:col-span-3">
        <p class="etichetta">{testi.contatti}</p>
        <ul class="mt-4 space-y-2.5 text-s">
          <li><a href={via(l, '/contatti')} class="text-tenue transition-colors hover:text-inchiostro">{testi.chiamata}</a></li>
          <li><a href={`mailto:${contatti.email}`} class="text-tenue transition-colors hover:text-inchiostro">{contatti.email}</a></li>
          <li><a href={contatti.github} class="text-tenue transition-colors hover:text-inchiostro">GitHub</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-14 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-filo pt-6 text-nota text-sottile">
      <p>© 2026 mitis · P.IVA {azienda.pIva}</p>
      <p class="flex flex-wrap gap-x-5 gap-y-1">
        <span>{testi.niente}</span>
        <a href={via(l, azienda.urlPrivacy)} class="hover:text-inchiostro">{testi.privacy}</a>
        <a href={via(l, azienda.urlCookie)} class="hover:text-inchiostro">{testi.cookie}</a>
      </p>
    </div>
  </div>
</footer>
