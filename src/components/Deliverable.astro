---
import Section from './Section.astro';
import Icona from './Icona.astro';
import { linguaDi } from '../i18n';

const l = linguaDi(Astro.url.pathname);

const testi = {
  it: {
    eyebrow: 'deliverable',
    titolo: 'Cosa c’è dentro, concretamente.',
    intro:
      'Lo stack è noto e scelto per essere operabile da un team piccolo. Niente pezzi esotici da accudire.',
    voci: [
      {
        icona: 'zona',
        nome: 'landing zone',
        testo:
          'confini chiari: multi-account su AWS, multi-project su GCP e Scaleway, multi-subscription su Azure',
      },
      {
        icona: 'strati',
        nome: 'terraform + atmos',
        testo: 'tutta l’infrastruttura come codice, organizzata per essere letta',
      },
      {
        icona: 'esagono',
        nome: 'kubernetes + argocd',
        testo: 'EKS, GKE o AKS, deploy dichiarativi: gli ambienti restano allineati a Git',
      },
      {
        icona: 'indicatore',
        nome: 'karpenter',
        testo: 'i nodi giusti, della taglia giusta, solo quando servono',
      },
      {
        icona: 'promozione',
        nome: 'promozioni con kargo',
        testo: 'da dev a produzione con regole scritte; il CI resta quello che usi già',
      },
      {
        icona: 'battito',
        nome: 'osservabilità',
        testo: 'metriche, log e allarmi che suonano solo quando serve',
      },
      {
        icona: 'chiave',
        nome: 'iam e sso',
        testo: 'least privilege di default, accessi centralizzati e revocabili',
      },
      {
        icona: 'discesa',
        nome: 'costi sotto controllo',
        testo: 'allocazione per team e servizio, budget e alert',
      },
      {
        icona: 'libro',
        nome: 'documentazione e runbook',
        testo: 'scritti per il tuo team, non per noi',
      },
    ],
    regolatoEyebrow: 'se operi in un settore regolato',
    regolato:
      'GDPR, NIS2, DORA per la finanza, ACN e AgID per chi lavora con la PA: una piattaforma fatta bene non ti certifica, ma rende le evidenze un sottoprodotto. Audit trail nativo, least privilege di default, e l’infrastruttura come codice è essa stessa la documentazione che l’auditor chiede.',
  },
  en: {
    eyebrow: 'deliverable',
    titolo: 'What’s inside, concretely.',
    intro:
      'The stack is well known and chosen to be operable by a small team. No exotic pieces to babysit.',
    voci: [
      {
        icona: 'zona',
        nome: 'landing zone',
        testo:
          'clear boundaries: multi-account on AWS, multi-project on GCP and Scaleway, multi-subscription on Azure',
      },
      {
        icona: 'strati',
        nome: 'terraform + atmos',
        testo: 'all infrastructure as code, organized to be read',
      },
      {
        icona: 'esagono',
        nome: 'kubernetes + argocd',
        testo: 'EKS, GKE or AKS, declarative deploys: environments stay aligned with Git',
      },
      {
        icona: 'indicatore',
        nome: 'karpenter',
        testo: 'the right nodes, the right size, only when needed',
      },
      {
        icona: 'promozione',
        nome: 'promotions with kargo',
        testo: 'from dev to production with written rules; the CI stays whatever you already use',
      },
      {
        icona: 'battito',
        nome: 'observability',
        testo: 'metrics, logs and alarms that only ring when they should',
      },
      {
        icona: 'chiave',
        nome: 'iam and sso',
        testo: 'least privilege by default, access centralized and revocable',
      },
      {
        icona: 'discesa',
        nome: 'costs under control',
        testo: 'allocation by team and service, budgets and alerts',
      },
      {
        icona: 'libro',
        nome: 'documentation and runbooks',
        testo: 'written for your team, not for us',
      },
    ],
    regolatoEyebrow: 'if you operate in a regulated sector',
    regolato:
      'GDPR, NIS2, DORA for finance, ACN and AgID if you work with the Italian public sector: a well-built platform doesn’t certify you, but it makes the evidence a by-product. Native audit trail, least privilege by default, and infrastructure as code is itself the documentation the auditor asks for.',
  },
}[l];
---

<Section eyebrow={testi.eyebrow} class="py-14 md:py-20">
  <h2 class="max-w-[24ch] font-display text-h2 font-bold" data-rivela>
    {testi.titolo}
  </h2>
  <p class="mt-5 max-w-[60ch] text-body text-carta/75" data-rivela>
    {testi.intro}
  </p>

  <dl class="mt-10 grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-3" data-rivela-serie>
    {
      testi.voci.map((v) => (
        <div class="group border-t border-carta/15 pt-4 transition-colors hover:border-lichene/60">
          <dt class="flex items-center gap-2.5 font-mono text-label text-carta transition-colors group-hover:text-lichene">
            <Icona nome={v.icona} class="h-[18px] w-[18px] text-lichene" />
            {v.nome}
          </dt>
          <dd class="mt-1.5 text-s text-carta/65">{v.testo}</dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-12 rounded-lg border border-carta/10 bg-quadro p-6 md:p-8" data-rivela>
    <p class="font-mono text-label text-carta/60">{testi.regolatoEyebrow}</p>
    <p class="mt-3 max-w-[72ch] text-body text-carta/80">
      {testi.regolato}
    </p>
  </div>
</Section>
