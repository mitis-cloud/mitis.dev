---
import { linguaDi, via } from '../i18n';

const l = linguaDi(Astro.url.pathname);

const testi = {
  it: {
    ariaLabel:
      "Simulazione da terminale: il pod in produzione riceve l'avviso di interruzione spot, Understudy trattiene l'eviction e avvia un pod sostituto che passa da Pending a Running; solo allora l'originale termina e sparisce. Il probe registra 764 richieste, 1 fallita.",
    barTitle: 'produzione — eks · karpenter · spot',
    replayAria: "Rivedi l'animazione",
    replay: '↻ rivedi',
  },
  en: {
    ariaLabel:
      'Terminal simulation: the pod in production receives a spot interruption notice, Understudy holds the eviction and starts a stand-in pod that goes from Pending to Running; only then does the original terminate and disappear. The probe records 764 requests, 1 failed.',
    barTitle: 'production — eks · karpenter · spot',
    replayAria: 'Replay the animation',
    replay: '↻ replay',
  },
}[l];

const ariaLabel = testi.ariaLabel;
---

<figure class="terminal" data-terminal>
  <figcaption class="bar">
    <span class="bar-dot" aria-hidden="true"></span>
    <span class="bar-title">{testi.barTitle}</span>
    <button class="replay" data-replay hidden aria-label={testi.replayAria}>{testi.replay}</button>
  </figcaption>

  <div class="body" role="img" aria-label={ariaLabel}>
    <div aria-hidden="true">
      <p class="tl cmd"><span class="typed">$ kubectl get pods -w -l app=tenant-worker</span></p>
      <p class="tl intesta">NAME                         READY  STATUS</p>
      <p class="tl pod pod-a"><span class="np">tenant-worker-6d8f7c-x2k4q</span>   <span class="cella ready-a">1/1</span>    <span class="cella stati-a"><span class="s sa-run ok">Running</span><span class="s sa-term warn">Terminating</span></span></p>
      <p class="tl pod pod-b"><span class="np">tenant-worker-6d8f7c-p9d2m</span>   <span class="cella ready-b"><span class="s rb-0 dim">0/1</span><span class="s rb-1">1/1</span></span>    <span class="cella stati-b"><span class="s sb-pen dim">Pending</span><span class="s sb-cc dim">ContainerCreating</span><span class="s sb-run ok">Running</span></span></p>
      <p class="tl evento"><span class="s ev-1 warn">! spot interruption: node spot-arm64-a7f3 (2m)</span><span class="s ev-2 op">understudy: holding eviction, starting stand-in</span><span class="s ev-3 op">understudy: stand-in ready, releasing original</span><span class="s ev-4 dim">understudy: standing down</span></p>
      <p class="tl probe">probe: <strong>764 requests, 1 failed</strong></p>
    </div>
  </div>
</figure>

<p class="mt-4 max-w-[56ch] text-s text-carta/65">
  {
    l === 'en' ? (
      <>
        This isn't a made-up animation: in a real spot interruption the probe measured{' '}
        <strong class="font-semibold text-carta">1 failed request out of 764</strong>. A routine
        rolling update loses 2 out of 38.{' '}
        <a
          href={via(l, '/kubernetes')}
          class="text-lichene underline underline-offset-4 hover:no-underline"
        >
          The context, on Kubernetes
        </a>
        .
      </>
    ) : (
      <>
        Non è un'animazione di fantasia: su un'interruzione spot reale il probe ha misurato{' '}
        <strong class="font-semibold text-carta">1 richiesta fallita su 764</strong>. Un rolling
        update di routine ne perde 2 su 38.{' '}
        <a
          href={via(l, '/kubernetes')}
          class="text-lichene underline underline-offset-4 hover:no-underline"
        >
          Il contesto, su Kubernetes
        </a>
        .
      </>
    )
  }
</p>

<style>
  .terminal {
    background-color: var(--color-schermo);
    border: 1px solid color-mix(in srgb, var(--color-carta) 14%, transparent);
    border-radius: 10px;
    overflow: hidden;
    box-shadow:
      0 0 60px color-mix(in srgb, var(--color-lichene) 9%, transparent),
      0 12px 40px rgba(0, 0, 0, 0.35);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-carta) 10%, transparent);
  }

  .bar-dot {
    width: 0.5rem;
    height: 0.5rem;
    background-color: var(--color-lichene);
    flex-shrink: 0;
  }

  .bar-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--color-carta) 55%, transparent);
  }

  .replay {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: color-mix(in srgb, var(--color-carta) 65%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-carta) 20%, transparent);
    border-radius: 5px;
    padding: 0.1rem 0.5rem;
    cursor: pointer;
    transition: color 150ms;
  }
  .replay:hover {
    color: var(--color-carta);
  }

  .body {
    padding: 1rem 1.25rem 1.25rem;
    overflow-x: auto;
  }
  @media (max-width: 400px) {
    .body {
      padding: 0.875rem 0.75rem 1rem;
    }
  }

  .tl {
    font-family: var(--font-mono);
    font-size: clamp(0.64rem, 0.42rem + 1vw, 0.8125rem);
    line-height: 1.85;
    white-space: pre;
    color: color-mix(in srgb, var(--color-carta) 88%, transparent);
    opacity: 0;
  }

  .cella {
    position: relative;
    display: inline-block;
    vertical-align: top;
  }
  .stati-a,
  .stati-b {
    width: 17ch;
  }
  .ready-b {
    width: 3ch;
  }
  .s {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
  }
  .stati-a .sa-run,
  .ready-b .rb-0,
  .stati-b .sb-pen,
  .evento .ev-1 {
    position: static;
    display: inline-block;
    opacity: 1;
  }

  .dim {
    color: color-mix(in srgb, var(--color-carta) 55%, transparent);
  }
  .ok {
    color: var(--color-lichene);
  }
  .op {
    color: var(--color-lichene);
  }
  .warn {
    color: var(--color-salmone);
  }
  .probe {
    margin-top: 0.9em;
    color: color-mix(in srgb, var(--color-carta) 70%, transparent);
  }
  .probe strong {
    color: var(--color-carta);
    font-weight: 700;
  }

  .pod-b {
    max-height: 0;
    overflow: hidden;
  }
  .evento {
    position: relative;
    min-height: 1.85em;
    margin-top: 0.9em;
  }

  .cmd .typed {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    max-width: 42ch;
    border-right: 0.45em solid var(--color-lichene);
  }

  /* ── coreografia ─────────────────────────────────────────────── */
  .terminal.play .cmd {
    opacity: 1;
  }
  .terminal.play .cmd .typed {
    animation:
      typing 1.1s steps(42) 0.15s backwards,
      caret 0.9s step-end 0.15s 3;
  }
  .terminal.play .intesta {
    animation: reveal 220ms ease-out 1.25s both;
  }
  .terminal.play .pod-a {
    animation:
      reveal 220ms ease-out 1.45s both,
      collassa 600ms ease-in 10.5s forwards;
  }
  .terminal.play .pod-b {
    animation: espandi 450ms ease-out 4.2s both;
  }
  .terminal.play .evento {
    animation: reveal 220ms ease-out 2.5s both;
  }
  .terminal.play .probe {
    animation: reveal 300ms ease-out 11.5s both;
  }

  .terminal.play .sa-run {
    animation: spento 200ms ease-in 9s forwards;
  }
  .terminal.play .sa-term {
    animation: acceso 200ms ease-out 9s forwards;
  }
  .terminal.play .rb-0 {
    animation: spento 150ms ease-in 7.2s forwards;
  }
  .terminal.play .rb-1 {
    animation: acceso 200ms ease-out 7.2s forwards;
  }
  .terminal.play .sb-pen {
    animation: spento 150ms ease-in 5.7s forwards;
  }
  .terminal.play .sb-cc {
    animation:
      acceso 150ms ease-out 5.7s forwards,
      spento 150ms ease-in 7.2s forwards;
  }
  .terminal.play .sb-run {
    animation: acceso 200ms ease-out 7.2s forwards;
  }

  .terminal.play .ev-1 {
    animation: spento 200ms ease-in 3.9s forwards;
  }
  .terminal.play .ev-2 {
    animation:
      acceso 200ms ease-out 4s forwards,
      spento 200ms ease-in 8s forwards;
  }
  .terminal.play .ev-3 {
    animation:
      acceso 200ms ease-out 8s forwards,
      spento 200ms ease-in 10.4s forwards;
  }
  .terminal.play .ev-4 {
    animation: acceso 200ms ease-out 10.4s forwards;
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes acceso {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes spento {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes espandi {
    from {
      max-height: 0;
      opacity: 0;
    }
    to {
      max-height: 1.85em;
      opacity: 1;
    }
  }
  @keyframes collassa {
    0% {
      max-height: 1.85em;
      opacity: 1;
    }
    40% {
      opacity: 0.25;
    }
    100% {
      max-height: 0;
      opacity: 0;
    }
  }
  @keyframes typing {
    from {
      max-width: 0;
    }
    to {
      max-width: 42ch;
    }
  }
  @keyframes caret {
    0%,
    100% {
      border-color: var(--color-lichene);
    }
    50% {
      border-color: transparent;
    }
  }

  /* ── fermo-immagine: A terminating, B running, probe visibile ── */
  @media (prefers-reduced-motion: reduce) {
    .tl,
    .terminal.play .tl {
      animation: none;
      opacity: 1;
    }
    .cmd .typed,
    .terminal.play .cmd .typed {
      animation: none;
      border-right: none;
    }
    .pod-b,
    .terminal.play .pod-b {
      animation: none;
      max-height: 1.85em;
    }
    .pod-a,
    .terminal.play .pod-a {
      animation: none;
      opacity: 0.45;
    }
    .s {
      animation: none !important;
      opacity: 0;
    }
    .sa-term,
    .rb-1,
    .sb-run,
    .ev-3 {
      opacity: 1 !important;
    }
    .sa-run,
    .rb-0,
    .sb-pen,
    .ev-1 {
      opacity: 0 !important;
    }
    .replay {
      display: none;
    }
  }
</style>

<noscript>
  <style>
    [data-terminal] .tl {
      animation: none;
      opacity: 1;
    }
    [data-terminal] .cmd span {
      border-right: none;
    }
    [data-terminal] .pod-b {
      max-height: 1.85em;
    }
    [data-terminal] .pod-a {
      opacity: 0.45;
    }
    [data-terminal] .s {
      opacity: 0;
    }
    [data-terminal] .sa-term,
    [data-terminal] .rb-1,
    [data-terminal] .sb-run,
    [data-terminal] .ev-3 {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const terminal = document.querySelector<HTMLElement>('[data-terminal]');
  const replay = document.querySelector<HTMLButtonElement>('[data-replay]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (terminal) {
    const play = () => {
      terminal.classList.remove('play');
      void terminal.offsetWidth;
      terminal.classList.add('play');
    };

    if (reduced || !('IntersectionObserver' in window)) {
      terminal.classList.add('play');
    } else {
      const io = new IntersectionObserver(
        (voci) => {
          if (voci.some((v) => v.isIntersecting)) {
            play();
            io.disconnect();
            if (replay) {
              setTimeout(() => {
                replay.hidden = false;
              }, 12200);
            }
          }
        },
        { threshold: 0.4 },
      );
      io.observe(terminal);
    }

    replay?.addEventListener('click', play);
  }
</script>
