---
import { linguaDi } from '../i18n';

const clienti = [
  { nome: 'Wolters Kluwer', file: '/clienti/wolters-kluwer.svg', w: 1134, h: 240, classe: 'h-[28px]' },
  { nome: 'Conio', file: '/clienti/conio.webp', w: 248, h: 85, classe: 'h-[26px]' },
  { nome: 'DBridge', file: '/clienti/dbridge.png', w: 102, h: 19, classe: 'h-[18px]' },
  { nome: 'Otherside Technology', file: '/clienti/otherside.svg', w: 469, h: 114, classe: 'h-[24px]' },
  { nome: 'EGlobe', file: '/clienti/eglobe.png', w: 191, h: 49, classe: 'h-[23px] globo' },
  { nome: 'ODDA Studio', file: '/clienti/odda.svg', w: 7004, h: 2257, classe: 'h-[24px]' },
  { nome: 'Cosmico', file: '/clienti/cosmico.svg', w: 131, h: 30, classe: 'h-[22px]' },
];

interface Props {
  senzaEtichetta?: boolean;
}
const { senzaEtichetta = false } = Astro.props;
const l = linguaDi(Astro.url.pathname);
const etichetta = l === 'en' ? 'Some of our clients' : 'Alcuni dei nostri clienti';
---

<div aria-label={etichetta} role="group">
  {!senzaEtichetta && <p class="etichetta mb-6">{etichetta}</p>}
  <ul class="flex flex-wrap items-center gap-x-12 gap-y-7">
    {
      clienti.map((c) => (
        <li class="flex items-center">
          <img src={c.file} alt={c.nome} width={c.w} height={c.h} class:list={['logo w-auto', c.classe]} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .logo {
    filter: var(--logo-filtro);
    opacity: 0.8;
  }
  .logo.globo {
    filter: grayscale(1) var(--logo-filtro);
  }
</style>
