---
interface Props {
  id?: string;
  eyebrow?: string;
  class?: string;
  container?: string;
}
const { id, eyebrow, class: className, container } = Astro.props;
---

<section id={id} class:list={['px-5 sm:px-8', className]}>
  <div class:list={['mx-auto w-full max-w-6xl', container]}>
    {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}
    <slot />
  </div>
</section>
